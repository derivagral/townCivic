{
  "name": "towncivic",
  "version": "0.1.0",
  "private": true,
  "description": "RSS for the jurisdiction \u2014 a primary-source event feed for a single Massachusetts town.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "towncivic": "./src/cli.ts"
  },
  "scripts": {
    "towncivic": "tsx src/cli.ts",
    "seed": "tsx src/cli.ts seed",
    "ingest": "tsx src/cli.ts ingest",
    "extract": "tsx src/cli.ts extract",
    "link": "tsx src/cli.ts link",
    "interpret": "tsx src/cli.ts interpret",
    "geocode": "tsx src/cli.ts geocode",
    "status": "tsx src/cli.ts status",
    "verify": "tsx src/cli.ts verify",
    "discover": "tsx src/cli.ts discover",
    "serve": "tsx src/cli.ts serve",
    "clear-samples": "tsx src/cli.ts clear-samples",
    "dev": "tsx watch src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.0.0",
    "hono": "^4.7.0",
    "pdfjs-dist": "^4.10.38",
    "undici": "^7.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
